# Copy to `.env.local` (gitignored) before `npm run build:native`.
# Vite loadEnv and `$env/static/public` inline this at build time.
# Leave unset / omit `.env.local` for production website builds so Google
# still receives https://actions.life/auth/callback.
#
# Until production /auth/callback bounces to life.actions.app://oauth, use the
# current Vercel preview of this branch (rotates per deploy — see PR 176):
# PUBLIC_NATIVE_OAUTH_REDIRECT=https://actions-2w2365sfg-intentions.vercel.app/auth/callback
PUBLIC_NATIVE_OAUTH_REDIRECT=
