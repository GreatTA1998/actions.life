{
  "appId": "life.actions.app",
  "appName": "actions.life",
  "webDir": "build",
  "backgroundColor": "#fafafa",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 400,
      "backgroundColor": "#fafafa",
      "showSpinner": false
    },
    "Camera": {
      "presentationStyle": "fullscreen"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#fafafa"
    }
  }
}
